# ---- build output -------------------------------------------------------
# Everything cmake generates lives under Build/, except Build/dist-win which is
# the shipped Windows Qt runtime and IS tracked.
Build/*
!Build/dist-win/
!Build/dist-win/**

# stray in-source CMake output (never should happen; belt and braces)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
Makefile
*.ninja
.ninja_deps
.ninja_log
.qt/
_deps/
# A build tree made the conventional way sits at the top of the repository
# (mkdir build && cd build && cmake ..), which Build/* does not reach -- its
# pattern is case-sensitive.
build/
build-*/
# JUCE's generated-source folder for the plug-in target (build scratch, the
# products themselves go to Build/<BuildName>_<Time>_<Host>_<OS>_<Platform>/)
*_artefacts/
dist/
*.o
*.a
*.so
*.obj
*.lib
*.pdb

# ---- third-party blobs ---------------------------------------------------
# JUCE is a git submodule pinned to upstream 8.0.13 (see .gitmodules), so a
# plain `git clone --recursive` brings it in and `git submodule update --init`
# repairs a non-recursive clone.  WebView2 is only needed for the legacy
# WebView editor, -DOVERTEON_QT_UI=OFF, so it stays vendored and ignored.
Source/third_party/juce.zip
Source/third_party/webview2/
Source/third_party/webview2.nupkg

# ---- secrets -------------------------------------------------------------
CI_PASSWD.txt

# ---- editor / OS noise ---------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
__pycache__/
*.pyc

# ---- release assets, not source -----------------------------------------
# The single-file VST3 is a GitHub Release attachment, not a repository file.
Build/dist-win/VST3/
debug.log

# accidental archive of the tree
*.tar
# ---- office / editor locks -----------------------------------------------
# LibreOffice and ONLYOFFICE drop a lock file beside a document while it is
# open.  These are per-machine state, never content: committing one makes every
# checkout look dirty the moment somebody opens the README.
.~lock.*#
#