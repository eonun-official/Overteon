# ---- build output -------------------------------------------------------
# Everything cmake generates lives under Build/, except Build/dist-win which is
# the shipped Windows Qt runtime and IS tracked.
Build/*
!Build/dist-win/
!Build/dist-win/**

# stray in-source CMake output (never should happen; belt and braces)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
*.ninja
.ninja_deps
.ninja_log
.qt/
_deps/
HarmonicInjector_artefacts/
dist/
*.o
*.a
*.so
*.obj
*.lib
*.pdb

# ---- third-party blobs ---------------------------------------------------
# Vendored, not source: JUCE is fetched by Config/CMakeLists.txt (pinned to
# 8.0.13) and the WebView2 NuGet package is only needed when building the
# legacy WebView editor with -DOVERTEON_QT_UI=OFF.
Source/third_party/JUCE/
Source/third_party/juce.zip
Source/third_party/webview2/
Source/third_party/webview2.nupkg

# ---- secrets -------------------------------------------------------------
CI_PASSWD.txt

# ---- editor / OS noise ---------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
__pycache__/
*.pyc

# accidental archive of the tree
*.tar
