#!/bin/bash
# ===========================================================================
#  generate — build the Overteon release installers in one place.
#
#  Everything that used to live in separate packaging scripts is here:
#
#      installman   self-contained Linux installer (one .sh, base64 payload)
#      nsis         Windows installer, built with NSIS (AUR package "nsis")
#      dmg          macOS disk image (needs macOS: hdiutil + Mach-O build)
#
#  The payload always comes from the product directories CMake wrote
#  (Build/<BuildName>_<Time>_<Host>_<OS>_<Platform>/), so the installers carry
#  exactly the binaries of the newest build.
#
#  Usage:
#      ./generate                     everything possible on this host
#      ./generate linux               installman only
#      ./generate windows             NSIS only
#      ./generate macos               DMG only (macOS host)
#      ./generate linux windows       several targets
#      ./generate --product DIR       use one product directory for one target
#      ./generate --out DIR           output directory (default Build/packages)
#
#  Environment:
#      QT_MSVC      Qt for Windows  (default ~/Qt-msvc/6.9.3/msvc2022_64)
#      MAKENSIS     makensis binary (default: makensis from PATH)
#      NSISDIR      NSIS data directory (set when makensis is not installed)
#
#  The NSIS compiler is the AUR package:
#
#      git clone https://aur.archlinux.org/nsis.git && cd nsis && makepkg -si
# ===========================================================================
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
OUT="$ROOT/Build/packages"
QT=${QT_MSVC:-$HOME/Qt-msvc/6.9.3/msvc2022_64}
MAKENSIS=${MAKENSIS:-makensis}
PRODUCT_OVERRIDE=
TARGETS=()

die() { echo "generate: $*" >&2; exit 1; }

usage() {
    sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
    case "$1" in
        linux|windows|macos|all) TARGETS+=("$1") ;;
        --product) shift; PRODUCT_OVERRIDE=${1:?missing directory after --product} ;;
        --out)     shift; OUT=${1:?missing directory after --out} ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument: $1 (see --help)" ;;
    esac
    shift
done

[ ${#TARGETS[@]} -gt 0 ] || TARGETS=(all)

VERSION=$(sed -n 's/^project(Overteon VERSION \([0-9][0-9.]*\)).*/\1/p' "$ROOT/Config/CMakeLists.txt" | head -1)
[ -n "$VERSION" ] || VERSION=0.0.0
mkdir -p "$OUT"

# Newest product directory for an OS field ("linux", "windows", "darwin").
product_dir() {
    local os=$1 latest=
    if [ -n "$PRODUCT_OVERRIDE" ]; then
        printf '%s\n' "$PRODUCT_OVERRIDE"
        return 0
    fi
    for d in "$ROOT"/Build/*_"$os"_*/; do
        [ -d "$d" ] || continue
        # Only real product directories: Overteon_<YYYYmmdd-HHMMSS>_<host>_<os>_<arch>.
        # Preview/test outputs (Overteon_rhi-preview_*...) sort after digits and must
        # not win the "newest" race just because of their name.
        [[ $(basename "$d") =~ ^Overteon_[0-9]{8}-[0-9]{6}_ ]] || continue
        latest=${d%/}
    done
    [ -n "$latest" ] || return 1
    printf '%s\n' "$latest"
}

stage_dir() {
    local d
    d=$(mktemp -d)
    printf '%s\n' "$d"
}

# ---------------------------------------------------------------------------
#  installman: self-contained Linux installer
# ---------------------------------------------------------------------------
build_installman() {
    local product stage payload_b64 sha outfile tarball
    product=$(product_dir linux) || die "no Linux product directory (build first: cmake --build Build/host)"
    [ -d "$product" ] || die "not a directory: $product"

    stage=$(stage_dir)
    tarball="$stage/payload.tar.gz"
    payload_b64="$stage/payload.b64"
    outfile="$OUT/Overteon-$VERSION-linux-x86_64-installman.sh"

    mkdir -p "$stage/payload"
    for part in Standalone VST3 VST LV2; do
        [ -d "$product/$part" ] && cp -a "$product/$part" "$stage/payload/$part"
    done
    [ -f "$product/README.txt" ] && cp "$product/README.txt" "$stage/payload/"
    [ -d "$product/docs" ] && cp -a "$product/docs" "$stage/payload/docs"

    tar -C "$stage/payload" -czf "$tarball" .
    sha=$(sha256sum "$tarball" | cut -d' ' -f1)
    base64 "$tarball" > "$payload_b64"

    local header="$stage/header"
    cat > "$header" <<'INSTALLMAN_HEADER'
#!/bin/sh
# Overteon self-contained Linux installer.
# Generated by ./generate; the payload is appended below.
set -eu

PREFIX=${PREFIX:-$HOME/.local}
ACTION=install

usage() {
    cat <<EOF
usage: $0 [-i | -r | -c | -s] [-p DIR]

  -i        install (default)
  -r        remove
  -c        check the embedded payload's integrity
  -s        show installed components
  -p DIR    where the standalone goes (default: ~/.local)
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -i) ACTION=install ;;
        -r) ACTION=remove ;;
        -c) ACTION=check ;;
        -s) ACTION=status ;;
        -p) shift; PREFIX=${1:?missing directory for -p} ;;
        -h|--help) usage; exit 0 ;;
        *) echo "unknown argument: $1" >&2; usage; exit 2 ;;
    esac
    shift
done

VST3_DIR=$HOME/.vst3/Overteon.vst3
VST2_DIR=$HOME/.vst
VST2=$VST2_DIR/Overteon.so
LV2_DIR=$HOME/.lv2/Overteon.lv2
BIN=$PREFIX/bin/Overteon
DESKTOP=$PREFIX/share/applications/overteon.desktop

payload() {
    # Everything after the marker line is the base64 payload.
    sed -e '1,/^__OVERTEON_PAYLOAD_BELOW__$/d' "$0"
}

check_payload() {
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    payload | base64 -d > "$tmp/payload.tar.gz"
    got=$(sha256sum "$tmp/payload.tar.gz" | cut -d' ' -f1)
    if [ "$got" = "__SHA256__" ]; then
        echo "payload OK (sha256 $got)"
        return 0
    fi
    echo "payload CORRUPT: expected __SHA256__, got $got" >&2
    return 1
}

extract_payload() {
    tmp=$(mktemp -d)
    payload | base64 -d > "$tmp/payload.tar.gz" || { echo "cannot decode payload" >&2; exit 1; }
    got=$(sha256sum "$tmp/payload.tar.gz" | cut -d' ' -f1)
    [ "$got" = "__SHA256__" ] || { echo "payload CORRUPT (sha256 $got)" >&2; rm -rf "$tmp"; exit 1; }
    tar -C "$tmp" -xzf "$tmp/payload.tar.gz"
    echo "$tmp"
}

case $ACTION in
check) check_payload ;;
install)
    src=$(extract_payload)
    trap 'rm -rf "$src"' EXIT

    if [ -x "$src/Standalone/Overteon" ]; then
        mkdir -p "$PREFIX/bin"
        cp -a "$src/Standalone/Overteon" "$BIN"
        echo "installed $BIN"
        mkdir -p "$(dirname "$DESKTOP")"
        cat > "$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=Overteon
Comment=Audio processor and EQ
Exec=$BIN
Terminal=false
Categories=Audio;AudioVideo;
EOF
        echo "installed $DESKTOP"
    fi

    if [ -d "$src/VST3" ]; then
        mkdir -p "$(dirname "$VST3_DIR")"
        rm -rf "$VST3_DIR"
        cp -a "$src/VST3"/Overteon.vst3 "$VST3_DIR"
        echo "installed $VST3_DIR"
    fi

    if [ -f "$src/VST/libOverteon.so" ]; then
        mkdir -p "$VST2_DIR"
        cp -a "$src/VST/libOverteon.so" "$VST2"
        echo "installed $VST2"
    fi

    if [ -d "$src/LV2" ]; then
        mkdir -p "$(dirname "$LV2_DIR")"
        rm -rf "$LV2_DIR"
        cp -a "$src/LV2"/Overteon.lv2 "$LV2_DIR"
        echo "installed $LV2_DIR"
    fi
    echo
    echo "Done. If your host does not rescan automatically, rescan its plug-in list."
    ;;
remove)
    [ -e "$BIN" ] && rm -f "$BIN" && echo "removed $BIN"
    [ -e "$DESKTOP" ] && rm -f "$DESKTOP" && echo "removed $DESKTOP"
    [ -e "$VST3_DIR" ] && rm -rf "$VST3_DIR" && echo "removed $VST3_DIR"
    [ -e "$VST2" ] && rm -f "$VST2" && echo "removed $VST2"
    [ -e "$LV2_DIR" ] && rm -rf "$LV2_DIR" && echo "removed $LV2_DIR"
    echo "Done."
    ;;
status)
    for item in "$VST3_DIR" "$VST2" "$LV2_DIR" "$BIN"; do
        if [ -e "$item" ]; then echo "installed  $item"; else echo "missing    $item"; fi
    done
    ;;
esac
exit 0
__OVERTEON_PAYLOAD_BELOW__
INSTALLMAN_HEADER

    sed "s/__SHA256__/$sha/g" "$header" > "$outfile"
    cat "$payload_b64" >> "$outfile"
    chmod +x "$outfile"
    rm -rf "$stage"
    echo "wrote $outfile"
}

# ---------------------------------------------------------------------------
#  nsis: Windows installer
# ---------------------------------------------------------------------------
deploy_qt() {  # deploy_qt <binary> <target dir>
    local bin=$1 target=$2
    python3 "$ROOT/Scripts/qt-closure.py" "$bin" --qt "$QT" --copy-to "$target" \
            --extra plugins/platforms/qwindows.dll >/dev/null
    cp -r "$QT/qml" "$target/qml"
}

build_nsis() {
    local product stage nsi outfile
    product=$(product_dir windows) || die "no Windows product directory (cross-build first)"
    [ -d "$product" ] || die "not a directory: $product"
    [ -d "$QT" ] || die "Qt for Windows not found at $QT (set QT_MSVC)"
    command -v "$MAKENSIS" >/dev/null 2>&1 || \
        die "makensis not found (build the AUR 'nsis' package, or set MAKENSIS)"

    stage=$(stage_dir)
    mkdir -p "$stage/payload/standalone" "$stage/payload/vst2" "$stage/payload/vst3"
    cp "$product/Standalone/Overteon.exe" "$stage/payload/standalone/"
    deploy_qt "$stage/payload/standalone/Overteon.exe" "$stage/payload/standalone"
    cp "$product/VST/Overteon.dll" "$stage/payload/vst2/"
    deploy_qt "$stage/payload/vst2/Overteon.dll" "$stage/payload/vst2"
    cp -r "$product/VST3/Overteon.vst3" "$stage/payload/vst3/"
    deploy_qt "$stage/payload/vst3/Overteon.vst3/Contents/x86_64-win/OverteonCore.dll" \
             "$stage/payload/vst3/Overteon.vst3/Contents/x86_64-win"

    nsi="$stage/overteon.nsi"
    cat > "$nsi" <<'NSIS_SCRIPT'
!include "MUI2.nsh"
!include "x64.nsh"

!ifndef APP_VERSION
  !define APP_VERSION "0.0.0"
!endif
!ifndef PAYLOAD_DIR
  !error "PAYLOAD_DIR is not defined"
!endif
!ifndef OUTFILE
  !error "OUTFILE is not defined"
!endif

!define APP_NAME      "Overteon"
!define APP_PUBLISHER "Eonun"
!define APP_URL       "https://eonun.com"
!define UNINST_KEY    "Software\Microsoft\Windows\CurrentVersion\Uninstall\Overteon"

Name "${APP_NAME} ${APP_VERSION}"
BrandingText "${APP_NAME} ${APP_VERSION}"
OutFile "${OUTFILE}"
InstallDir "$PROGRAMFILES64\${APP_NAME}"
InstallDirRegKey HKLM "${UNINST_KEY}" "InstallLocation"
RequestExecutionLevel admin
SetCompressor /SOLID lzma
SetCompressorDictSize 64

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\Overteon.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Run ${APP_NAME}"
!define MUI_FINISHPAGE_LINK "Overteon on the web"
!define MUI_FINISHPAGE_LINK_LOCATION "${APP_URL}"
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Section "Standalone application" SEC_STANDALONE
    SectionIn RO
    SetOutPath "$INSTDIR"
    File /r "${PAYLOAD_DIR}/standalone/*"
    WriteUninstaller "$INSTDIR\Uninstall.exe"
    CreateDirectory "$SMPROGRAMS\${APP_NAME}"
    CreateShortCut  "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk" "$INSTDIR\Overteon.exe"
    CreateShortCut  "$DESKTOP\${APP_NAME}.lnk" "$INSTDIR\Overteon.exe"
    WriteRegStr   HKLM "${UNINST_KEY}" "DisplayName"     "${APP_NAME} ${APP_VERSION}"
    WriteRegStr   HKLM "${UNINST_KEY}" "DisplayVersion"  "${APP_VERSION}"
    WriteRegStr   HKLM "${UNINST_KEY}" "Publisher"       "${APP_PUBLISHER}"
    WriteRegStr   HKLM "${UNINST_KEY}" "URLInfoAbout"    "${APP_URL}"
    WriteRegStr   HKLM "${UNINST_KEY}" "DisplayIcon"     "$INSTDIR\Overteon.exe"
    WriteRegStr   HKLM "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
    WriteRegStr   HKLM "${UNINST_KEY}" "UninstallString" "$INSTDIR\Uninstall.exe"
    WriteRegDWORD HKLM "${UNINST_KEY}" "NoModify" 1
    WriteRegDWORD HKLM "${UNINST_KEY}" "NoRepair" 1
SectionEnd

Section "VST3 plug-in (64-bit)" SEC_VST3
    SetOutPath "$COMMONFILES64\VST3"
    File /r "${PAYLOAD_DIR}/vst3/Overteon.vst3"
SectionEnd

Section "VST2 plug-in (64-bit)" SEC_VST2
    SetOutPath "$COMMONFILES64\VST2\${APP_NAME}"
    File /r "${PAYLOAD_DIR}/vst2/*"
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
    !insertmacro MUI_DESCRIPTION_TEXT ${SEC_STANDALONE} "The standalone application, with its Qt runtime."
    !insertmacro MUI_DESCRIPTION_TEXT ${SEC_VST3} "VST3 plug-in, installed into the system VST3 folder."
    !insertmacro MUI_DESCRIPTION_TEXT ${SEC_VST2} "VST2 plug-in, in a private folder (add it to the host's VST2 paths)."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section "Uninstall"
    Delete "$DESKTOP\${APP_NAME}.lnk"
    RMDir /r "$SMPROGRAMS\${APP_NAME}"
    RMDir /r "$INSTDIR"
    RMDir /r "$COMMONFILES64\VST3\Overteon.vst3"
    RMDir /r "$COMMONFILES64\VST2\${APP_NAME}"
    DeleteRegKey HKLM "${UNINST_KEY}"
SectionEnd
NSIS_SCRIPT

    outfile="$OUT/Overteon-$VERSION-windows-x64-setup.exe"
    [ -n "${NSISDIR:-}" ] && export NSISDIR
    "$MAKENSIS" -V2 \
        -DAPP_VERSION="$VERSION" \
        -DPAYLOAD_DIR="$stage/payload" \
        -DOUTFILE="$outfile" \
        "$nsi"
    rm -rf "$stage"
    echo "wrote $outfile"
}

# ---------------------------------------------------------------------------
#  dmg: macOS disk image
# ---------------------------------------------------------------------------
build_dmg() {
    local product stage vol outfile arch
    [ "$(uname -s)" = Darwin ] || die "dmg needs macOS (hdiutil + a darwin build); run this target on a Mac"
    product=$(product_dir darwin) || die "no darwin product directory (build on macOS first)"
    [ -d "$product" ] || die "not a directory: $product"

    case "$(uname -m)" in arm64) arch=arm64 ;; *) arch=x86_64 ;; esac
    stage=$(stage_dir)
    vol="Overteon $VERSION"
    mkdir -p "$stage/$vol"

    local copied=0 item
    for item in Standalone/Overteon.app Standalone/Overteon \
                VST3/Overteon.vst3 VST/Overteon.vst \
                AU/Overteon.component LV2/Overteon.lv2; do
        [ -e "$product/$item" ] || continue
        cp -a "$product/$item" "$stage/$vol/"
        copied=1
    done
    [ "$copied" = 1 ] || die "product directory has nothing to package: $product"
    [ -f "$product/README.txt" ] && cp "$product/README.txt" "$stage/$vol/"
    [ -d "$product/docs" ] && cp -a "$product/docs" "$stage/$vol/"
    ln -s /Applications "$stage/$vol/Applications"

    outfile="$OUT/Overteon-$VERSION-macos-$arch.dmg"
    rm -f "$outfile"
    hdiutil create -volname "$vol" -srcfolder "$stage/$vol" -ov -format UDZO -fs HFS+ "$outfile"
    hdiutil verify "$outfile"
    rm -rf "$stage"
    echo "wrote $outfile"
}

# ---------------------------------------------------------------------------
for target in "${TARGETS[@]}"; do
    case "$target" in
        all)
            build_installman
            if [ "$(uname -s)" = Darwin ]; then
                build_dmg
            elif product_dir windows >/dev/null 2>&1; then
                build_nsis
            fi
            ;;
        linux)   build_installman ;;
        windows) build_nsis ;;
        macos)   build_dmg ;;
    esac
done
